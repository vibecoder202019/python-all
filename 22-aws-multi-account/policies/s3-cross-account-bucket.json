{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDevRolePutObject",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::DEV_ACCOUNT_ID:role/DevOpsCrossAccountRole"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME",
        "arn:aws:s3:::BUCKET_NAME/dev/*"
      ]
    }
  ]
}
