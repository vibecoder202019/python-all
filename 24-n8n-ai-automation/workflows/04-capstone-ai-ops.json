{
  "name": "Capstone — AWX via Agent Bridge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "awx-run",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Webhook AWX Run",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "awx-capstone-run"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BRIDGE_URL || 'http://host.docker.internal:8090' }}/agent/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-API-Key", "value": "={{ $env.BRIDGE_API_KEY || 'lab-bridge-key' }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"intent\": \"launch_job\",\n  \"template_name\": \"{{ $json.body.template_name || 'Python Hello World' }}\",\n  \"extra_vars\": {{ $json.body.extra_vars || {\"user_name\": \"n8n-capstone\"} }},\n  \"wait\": true\n}"
      },
      "id": "http-bridge",
      "name": "Call Agent Bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "respond-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook AWX Run": {
      "main": [[{ "node": "Call Agent Bridge", "type": "main", "index": 0 }]]
    },
    "Call Agent Bridge": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": true }
}
